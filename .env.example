# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Get this from @userinfobot on Telegram
MY_TELEGRAM_USER_ID=your_telegram_id_here

# Server port for the dashboard
PORT=3000

# Path to SQLite database file
# On Railway: set to /data/expenses.db and mount a volume at /data
# Locally: leave unset (defaults to ./expenses.db)
DATABASE_PATH=
