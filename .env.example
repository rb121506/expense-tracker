# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Get this from @userinfobot on Telegram
MY_TELEGRAM_USER_ID=your_telegram_id_here

# Server port for the dashboard (local only)
PORT=3000

# Neon Postgres connection string
# Get this from https://neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Optional: dashboard passcode (leave blank for no auth)
DASHBOARD_PASSCODE=

# Gemini API key for AI Chat (free tier)
# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
